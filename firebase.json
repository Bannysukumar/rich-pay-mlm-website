{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/call/registerWithProfile",
        "function": { "functionName": "registerWithProfile", "region": "us-central1" }
      },
      {
        "source": "/api/call/publicResolveReferrer",
        "function": { "functionName": "publicResolveReferrer", "region": "us-central1" }
      },
      {
        "source": "/api/call/requestPasswordReset",
        "function": { "functionName": "requestPasswordReset", "region": "us-central1" }
      },
      {
        "source": "/api/call/completePasswordReset",
        "function": { "functionName": "completePasswordReset", "region": "us-central1" }
      },
      {
        "source": "/api/call/finalizeLoginPasswordChange",
        "function": { "functionName": "finalizeLoginPasswordChange", "region": "us-central1" }
      },
      {
        "source": "/api/call/adminResetMemberLoginPassword",
        "function": { "functionName": "adminResetMemberLoginPassword", "region": "us-central1" }
      },
      {
        "source": "/api/call/updateMemberProfile",
        "function": { "functionName": "updateMemberProfile", "region": "us-central1" }
      },
      {
        "source": "/api/call/changeTransactionPassword",
        "function": { "functionName": "changeTransactionPassword", "region": "us-central1" }
      },
      {
        "source": "/api/call/resolveUsername",
        "function": { "functionName": "resolveUsername", "region": "us-central1" }
      },
      {
        "source": "/api/call/activatePackage",
        "function": { "functionName": "activatePackage", "region": "us-central1" }
      },
      {
        "source": "/api/call/createWithdrawal",
        "function": { "functionName": "createWithdrawal", "region": "us-central1" }
      },
      {
        "source": "/api/call/walletConvert",
        "function": { "functionName": "walletConvert", "region": "us-central1" }
      },
      {
        "source": "/api/call/convertIncomeToActivation",
        "function": { "functionName": "convertIncomeToActivation", "region": "us-central1" }
      },
      {
        "source": "/api/call/internalTransfer",
        "function": { "functionName": "internalTransfer", "region": "us-central1" }
      },
      {
        "source": "/api/call/listAllDownlines",
        "function": { "functionName": "listAllDownlines", "region": "us-central1" }
      },
      {
        "source": "/api/call/listDirectReferrals",
        "function": { "functionName": "listDirectReferrals", "region": "us-central1" }
      },
      {
        "source": "/api/call/adminWithdrawalUpdate",
        "function": { "functionName": "adminWithdrawalUpdate", "region": "us-central1" }
      },
      {
        "source": "/api/call/adminFinalizeDeposit",
        "function": { "functionName": "adminFinalizeDeposit", "region": "us-central1" }
      },
      {
        "source": "/api/call/adminRepairWalletShadowFields",
        "function": { "functionName": "adminRepairWalletShadowFields", "region": "us-central1" }
      },
      {
        "source": "/api/call/adminAdjustMemberBalances",
        "function": { "functionName": "adminAdjustMemberBalances", "region": "us-central1" }
      },
      {
        "source": "/api/call/adminPreviewBulkWalletTransfer",
        "function": { "functionName": "adminPreviewBulkWalletTransfer", "region": "us-central1" }
      },
      {
        "source": "/api/call/adminBulkWalletTransfer",
        "function": { "functionName": "adminBulkWalletTransfer", "region": "us-central1" }
      },
      {
        "source": "/api/call/adminMemberWalletTransfer",
        "function": { "functionName": "adminMemberWalletTransfer", "region": "us-central1" }
      },
      {
        "source": "/api/call/adminUpdateMemberContact",
        "function": { "functionName": "adminUpdateMemberContact", "region": "us-central1" }
      },
      {
        "source": "/api/call/getReferralCampaignProgress",
        "function": { "functionName": "getReferralCampaignProgress", "region": "us-central1" }
      },
      {
        "source": "/api/call/dismissReferralCampaignBanner",
        "function": { "functionName": "dismissReferralCampaignBanner", "region": "us-central1" }
      },
      {
        "source": "/api/call/adminListReferralCampaignCompletions",
        "function": { "functionName": "adminListReferralCampaignCompletions", "region": "us-central1" }
      },
      {
        "source": "/api/call/adminDeleteMember",
        "function": { "functionName": "adminDeleteMember", "region": "us-central1" }
      },
      {
        "source": "/api/call/adminBroadcastNotification",
        "function": { "functionName": "adminBroadcastNotification", "region": "us-central1" }
      },
      {
        "source": "/api/call/adminSeedCompensationDefaults",
        "function": { "functionName": "adminSeedCompensationDefaults", "region": "us-central1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      }
    ]
  }
}
