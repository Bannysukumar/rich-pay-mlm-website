{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/call/registerWithProfile",
        "function": { "functionName": "registerWithProfile", "region": "us-central1" }
      },
      {
        "source": "/api/call/updateMemberProfile",
        "function": { "functionName": "updateMemberProfile", "region": "us-central1" }
      },
      {
        "source": "/api/call/changeTransactionPassword",
        "function": { "functionName": "changeTransactionPassword", "region": "us-central1" }
      },
      {
        "source": "/api/call/resolveUsername",
        "function": { "functionName": "resolveUsername", "region": "us-central1" }
      },
      {
        "source": "/api/call/activatePackage",
        "function": { "functionName": "activatePackage", "region": "us-central1" }
      },
      {
        "source": "/api/call/createWithdrawal",
        "function": { "functionName": "createWithdrawal", "region": "us-central1" }
      },
      {
        "source": "/api/call/walletConvert",
        "function": { "functionName": "walletConvert", "region": "us-central1" }
      },
      {
        "source": "/api/call/convertIncomeToActivation",
        "function": { "functionName": "convertIncomeToActivation", "region": "us-central1" }
      },
      {
        "source": "/api/call/internalTransfer",
        "function": { "functionName": "internalTransfer", "region": "us-central1" }
      },
      {
        "source": "/api/call/listAllDownlines",
        "function": { "functionName": "listAllDownlines", "region": "us-central1" }
      },
      {
        "source": "/api/call/listDirectReferrals",
        "function": { "functionName": "listDirectReferrals", "region": "us-central1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      }
    ]
  }
}
