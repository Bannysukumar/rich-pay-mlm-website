VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: Google Analytics (same as Firebase console measurementId)
VITE_FIREBASE_MEASUREMENT_ID=
# Optional: region for callable functions (default us-central1)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Local dev: Firebase SDK calls functions directly (correct URL for your project/region).
# Set to true only if you need the Vite `/api/call/*` proxy (e.g. special Cloud Run invoker setup).
# VITE_USE_FUNCTIONS_PROXY=true
# If using the proxy, override the forward base if 404 (Gen‑2 may use a different host than cloudfunctions.net):
# FUNCTIONS_PROXY_ORIGIN=https://us-central1-YOUR_PROJECT.cloudfunctions.net
# Optional: base URL shown in dashboard referral link (default: current origin). Example: https://richpay.world
# VITE_REFERRAL_BASE_URL=

# Local dev only: if /api/call/* returns 403, Gen-2 Cloud Run likely blocks unauthenticated invoke.
# Fix A — GCP Console → Cloud Run → your function → Permissions → grant allUsers "Cloud Run Invoker", or redeploy functions with invoker public.
# Fix B — optional fallback only: fresh token (~1h): gcloud auth print-identity-token. Never leave an expired value here — it overrides keyfile and returns **401**.
# FUNCTIONS_PROXY_BEARER=
# Fix C — only if Register is NOT public invoker: set keyfile AND FUNCTIONS_PROXY_REGISTER_SA_TOKEN=true so the dev proxy mints a Cloud Run ID token for registerWithProfile (never commit keyfile).
# Example: FUNCTIONS_PROXY_KEYFILE=../service-account.json
# FUNCTIONS_PROXY_REGISTER_SA_TOKEN=true
# FUNCTIONS_PROXY_KEYFILE=
