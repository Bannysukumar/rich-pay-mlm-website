rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /usersByUsername/{username} {
      allow read: if true;
      allow write: if false;
    }

    match /phoneIndex/{phone} {
      allow read, write: if false;
    }

    match /counters/{id} {
      allow read, write: if false;
    }

    // --- Public config ---
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seoSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cmsPages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Packages (read for members, admin writes) ---
    match /packages/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teamLevels/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /ranks/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Financial docs ---
    match /deposits/{id} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /withdrawals/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /activePackages/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /topups/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /walletTransactions/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /internalTransfers/{id} {
      allow read: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.recipientUid == request.auth.uid
        ) || isAdmin();
      allow write: if isAdmin();
    }

    match /dailyProfits/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /sponsorBonuses/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /teamLevelBonuses/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /rankBonuses/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /tickets/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /ticketReplies/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
