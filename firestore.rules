rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Custom claim admin OR Firestore profile role (client session uses profile.role).
    function profileIsAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.admin == true || profileIsAdmin());
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // --- Users ---
    function onlyReferralBannerDismiss() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['dismissedReferralCampaignBanners', 'updatedAt']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, delete: if false;
      // Members update profiles via Callable only; admins may manage member records here.
      allow update: if isAdmin() || (isOwner(userId) && onlyReferralBannerDismiss());
    }

    match /usersByUsername/{username} {
      allow read: if true;
      allow write: if false;
    }

    match /phoneIndex/{phone} {
      allow read, write: if false;
    }

    match /counters/{id} {
      allow read, write: if false;
    }

    // --- Public config ---
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seoSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cmsPages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Packages (public may read active tiers for marketing pages; admins see all.) ---
    match /packages/{id} {
      allow read: if isAdmin() || resource.data.active == true;
      allow write: if isAdmin();
    }

    match /teamLevels/{id} {
      allow read: if isAdmin() || resource.data.active == true;
      allow write: if isAdmin();
    }

    match /ranks/{id} {
      allow read: if isAdmin() || resource.data.active == true;
      allow write: if isAdmin();
    }

    match /referralCampaigns/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Financial docs ---
    match /deposits/{id} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /withdrawals/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /activePackages/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /topups/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /walletTransactions/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /internalTransfers/{id} {
      allow read: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.recipientUid == request.auth.uid
        ) || isAdmin();
      allow write: if isAdmin();
    }

    match /dailyProfits/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /sponsorBonuses/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /teamLevelBonuses/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /rankBonuses/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /tickets/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /ticketReplies/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
