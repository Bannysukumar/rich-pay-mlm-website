rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function fsUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isFirestoreAdmin() {
      return request.auth != null && fsUser().data.role == 'admin';
    }

    // Public site assets (QR, CMS images) — admins upload; everyone can read.
    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if isFirestoreAdmin();
    }

    match /deposits/{userId}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == userId
          || request.auth.token.admin == true
          || isFirestoreAdmin());
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
